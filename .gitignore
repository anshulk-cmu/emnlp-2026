# Cluster scratch — symlink to /data/user_data/anshulk/emnlp2026 (51 GB of
# model weights, activations, intermediate results). Track plots under
# data/figures/ only; exclude everything else under data/.
data/*
!data/figures/
!data/figures/**

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Editor / OS
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Local Claude Code workspace (per-project settings, not part of the project)
.claude/

# SLURM stdout/stderr if any leak into the repo root
slurm-*.out
slurm-*.err

# Stray experiment artefacts
*.npy
*.pt
*.pkl
*.log
